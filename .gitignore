# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/npm-debug.log*
/yarn-error.log

# Yarn Berry (PnP)
# 注意：yarn.lock 和 .pnp.cjs 必须提交，保证依赖版本一致
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarn/install-state.gz
.yarn/unplugged

# production
/dist

# misc
.DS_Store

# umi
/src/.umi
/src/.umi-production
/src/.umi-test

# environment variables
.env
.env.local
.env.*.local

# editor
.idea/
*.swp

# CodeBuddy local data
.codebuddy/
